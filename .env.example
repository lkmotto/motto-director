# motto-director env vars.
#
# Existing director config (Anthropic, GitHub, Northflank API) lives in the
# sdr-agent-secrets shared group on Doppler/Northflank. The vars below were
# added by the agent-observability-setup PR — director still works without
# them (everything no-ops gracefully) but you'll get no fleet awareness or
# Langfuse traces.

# --- Langfuse (LLM-aware OTel backend) ---
OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
# Authorization=Basic base64(public_key:secret_key)
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <b64(pk:sk)>
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# --- motto-mcp-server (Neon-backed fleet coordinator) ---
MOTTO_MCP_URL=https://motto-mcp.northflank.app/mcp
MOTTO_MCP_AUTH_TOKEN=replace-me

# --- Optional metadata ---
AGENT_VERSION=0.1.0
DEPLOY_TARGET=northflank
OTEL_SERVICE_NAME=motto-director
